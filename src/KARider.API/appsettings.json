{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Institucion": {
    "Nombre": "UTTT",
    "DominioCorreo": "uttt.edu.mx",
    "ZonaHoraria": "America/Mexico_City"
  },
  "Seguridad": {
    "MaxIntentosFallidos": 5,
    "MinutosBloqueo": 15,
    "MinutosExpiracionCodigo": 15,
    "MaxIntentosCodigo": 5,
    "SegundosEntreCodigos": 60,
    "DiasRefreshToken": 7,
    "DiasRefreshTokenRecordarme": 30
  },
  "Estadisticas": {
    "KgCo2PorAsientoCompartido": 2.3
  },
  "Jwt": {
    "Issuer": "KARider.API",
    "Audience": "KARider.PWA",
    "SigningKey": "",
    "AccessTokenMinutes": 15
  },
  "Hashing": {
    "Pepper": ""
  },
  "Database": {
    "AplicarMigracionesAlIniciar": false,
    "CommandTimeoutSegundos": 30,
    "MaxReintentos": 3,
    "TamanoPoolContextos": 256
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "SolicitudesPorMinuto": 120,
    "SolicitudesAuthPorMinuto": 10
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Usuario": "",
    "Password": "",
    "HabilitarSsl": true,
    "Remitente": "no-reply@karider.app",
    "NombreRemitente": "KARider UTTT"
  },
  "WebPush": {
    "Subject": "mailto:soporte@karider.app",
    "PublicKey": "",
    "PrivateKey": ""
  },
  "Swagger": {
    "Habilitado": false
  },
  "Rendimiento": {
    "MinWorkerThreads": 0
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576,
      "KeepAliveTimeout": "00:02:00",
      "RequestHeadersTimeout": "00:00:30"
    }
  }
}
