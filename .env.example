# ============================================================================
# KARider API · Variables de entorno
# Copia este archivo como .env (NUNCA lo subas a git; ya está en .gitignore).
# En Azure App Service se configuran en: Configuración > Variables de entorno.
# El separador "__" equivale a ":" en appsettings (ej. Jwt__SigningKey = Jwt:SigningKey).
# ============================================================================

ASPNETCORE_ENVIRONMENT=Development

# --- PostgreSQL 15 (base de datos externa) ----------------------------------
# Producción: usa SSL Mode=Require y un usuario con permisos mínimos.
# Pool de conexiones: subir Maximum Pool Size si escalas verticalmente la base de datos.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=karider;Username=karider;Password=CAMBIAR_PASSWORD_DB;SSL Mode=Prefer;Maximum Pool Size=100;Timeout=15;Command Timeout=30

# Solo para docker-compose local (contenedor postgres:15). Puerto 5433 para no chocar con un PostgreSQL instalado en Windows.
POSTGRES_PORT=5433
POSTGRES_DB=karider
POSTGRES_USER=karider
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_DB

# Aplica migraciones al iniciar (recomendado solo en desarrollo o con una sola instancia)
Database__AplicarMigracionesAlIniciar=true

# --- Seguridad (obligatorias, mínimo 32 caracteres cada una) ----------------
# Genera valores con: pwsh ./scripts/generar-secretos.ps1   o   openssl rand -base64 48
Jwt__SigningKey=
Hashing__Pepper=
Jwt__Issuer=KARider.API
Jwt__Audience=KARider.PWA
Jwt__AccessTokenMinutes=15

# --- CORS: orígenes del frontend PWA (uno por índice) ------------------------
Cors__AllowedOrigins__0=http://localhost:5173
# Cors__AllowedOrigins__1=https://karider.azurestaticapps.net

# --- Hosts permitidos (opcional). Por defecto "*". Para restringir, usa el dominio
#     predeterminado exacto del App Service (Información general → Dominio predeterminado).
# AllowedHosts=karider-api.azurewebsites.net

# --- Correo (SMTP) para códigos de verificación ------------------------------
# Si se deja vacío, en Development el código se imprime en la consola de la API.
Smtp__Host=
Smtp__Port=587
Smtp__Usuario=
Smtp__Password=
Smtp__HabilitarSsl=true
Smtp__Remitente=no-reply@karider.app

# --- Notificaciones push (VAPID). Genera con: npx web-push generate-vapid-keys
WebPush__Subject=mailto:soporte@karider.app
WebPush__PublicKey=
WebPush__PrivateKey=

# --- Observabilidad (Azure Application Insights, opcional) ------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Swagger UI (/swagger). Mantener en false en producción.
Swagger__Habilitado=true
